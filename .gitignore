# Dependency install lokal, di-restore ulang lewat pnpm install.
node_modules/

# Output build tiap app.
.next/
dist/
build/

# Prisma client hasil generate — bukan source, jangan di-commit.
packages/database/src/generated/

# Cache Turborepo.
.turbo/

# Environment file berisi secret, jangan pernah commit.
.env
.env.local
.env.*.local

# Log & file OS/editor.
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json

# Swap file vim/nano — umum muncul kalau edit langsung di terminal Linux.
*.swp
*.swo

# Cache incremental TypeScript (tsc --incremental) — regenerate otomatis, bukan source.
*.tsbuildinfo

# --- Tambahan ---

# Semua varian file env berisi secret (mis. .env.production, .env.staging) —
# hanya .env.example (template tanpa nilai asli) yang boleh masuk repo.
.env.*
!.env.example

# Kunci & sertifikat — jangan pernah commit.
*.pem
*.key
*.p12
*.pfx

# pnpm/npm/yarn: store lokal & log debug.
.pnpm-store/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage & tooling deploy lokal.
coverage/
.vercel/

# Setting pribadi Claude Code (bukan bagian repo; CLAUDE.md tetap di-commit).
.claude/settings.local.json

# File sampah OS & editor (Windows, JetBrains).
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/

# Folder scratch & dump database lokal.
tmp/
*.dump
*.sql.gz
