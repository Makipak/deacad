# Salin file ini jadi .env lalu isi nilai asli. Jangan commit .env.

# --- Database (dipakai packages/database & apps/api) ---
# Port host 5434 (bukan default 5432) — docker-compose.yml maps postgres ke "5434:5432" karena
# 5432/5433 sering sudah dipakai instance Postgres lain di mesin dev (native atau project lain).
DATABASE_URL="postgresql://deacad:deacad@localhost:5434/deacad?schema=public"

# (Redis sudah tidak dipakai — antrian convert sekarang tabel Postgres "convert_jobs".)

# --- JWT (dipakai apps/api) ---
JWT_ACCESS_SECRET="ganti-dengan-random-string-panjang"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="ganti-dengan-random-string-panjang-berbeda"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Midtrans (dipakai apps/api, module transactions) ---
MIDTRANS_SERVER_KEY="Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# --- Transactional email (dipakai apps/api, module auth) ---
# Kosongkan ("") kalau belum ada key Resend — EmailService sengaja cuma log link verifikasi ke
# console selama kosong. Isi placeholder ("re_xxx...") malah bikin dia coba call Resend sungguhan
# dan gagal 401 tanpa cara lihat link verifikasinya (lihat CLAUDE.md "Known local dev gotchas").
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="noreply@deacad.example"

# --- Object storage file asli & hasil convert (dipakai api & worker) ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="deacad"
# URL storage yang DISIMPAN ke DB & dibuka browser — isi hanya kalau beda dari STORAGE_ENDPOINT
# (mis. demo ngrok: "https://xxx.ngrok-free.app", MinIO di-proxy nginx di path /deacad/;
# atau api jalan di container sementara browser akses lewat host). Kosong = pakai STORAGE_ENDPOINT.
STORAGE_PUBLIC_ENDPOINT=""
# Region S3 — B2: "us-west-004" (lihat endpoint bucket), R2: "auto", MinIO: biarkan kosong.
STORAGE_REGION=""
# Base URL publik tempat file dibuka browser (menggantikan {endpoint}/{bucket}).
# B2: "https://f004.backblazeb2.com/file/<bucket>"  |  R2: "https://pub-xxxx.r2.dev". Kosong = default MinIO.
STORAGE_PUBLIC_BASE_URL=""

# --- Upload & worker ---
# PPTX butuh LibreOffice di worker. Shared hosting: biarkan false (user ekspor PPT → PDF).
ALLOW_PPTX_UPLOAD="false"
NEXT_PUBLIC_ALLOW_PPTX="false"
# Worker default mode "once" (dijalankan cron, drain antrian lalu exit). Docker/VPS: WORKER_MODE="loop".
WORKER_MODE="once"
WORKER_MAX_CONCURRENCY="1"
WORKER_RUN_BUDGET_SECONDS="600"
CONVERT_MAX_PAGES="300"

# --- Production di belakang reverse proxy (Passenger/nginx) ---
TRUST_PROXY="1"
# Secret untuk endpoint cron: POST /api/v1/internal/cron/reconcile (header x-cron-secret).
CRON_SECRET="ganti-dengan-random-string-panjang"

# --- CORS (dipakai apps/api) ---
CORS_ORIGIN="http://localhost:3000"

# --- Next.js (dipakai apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Sama persis dengan MIDTRANS_CLIENT_KEY di atas — client key Midtrans memang didesain publik
# (dipakai buat load Snap.js di browser), beda dari MIDTRANS_SERVER_KEY yang harus rahasia.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"

# --- App port ---
API_PORT="4000"
